+func (s *workflowResetterSuite) TestCopySignalRequestedIDs() {
+	// the base run holds the dedup ID of a signal that an earlier reset reapplied (the
+	// reapplied event in its history has no request ID)
+	domainName := uuid.New()
+	s.mockShard.Resource.DomainCache.EXPECT().GetDomainName(s.domainID).Return(domainName, nil).AnyTimes()
+	s.mockShard.Resource.ExecutionMgr.On("GetWorkflowExecution", mock.Anything, &persistence.GetWorkflowExecutionRequest{
+		DomainID:   s.domainID,
+		Execution:  types.WorkflowExecution{WorkflowID: s.workflowID, RunID: s.baseRunID},
+		DomainName: domainName,
+	}).Return(&persistence.GetWorkflowExecutionResponse{
+		State: &persistence.WorkflowMutableState{
+			SignalRequestedIDs: map[string]struct{}{"reapplied-signal-request-id": {}},
+		},
+	}, nil).Once()
+
+	resetMutableState := execution.NewMockMutableState(s.controller)
+	resetMutableState.EXPECT().AddSignalRequested("reapplied-signal-request-id").Times(1)
+
+	err := s.workflowResetter.copySignalRequestedIDs(context.Background(), s.domainID, s.workflowID, s.baseRunID, resetMutableState)
+	s.NoError(err)
+}
