+func (s *workflowResetterSuite) TestReapplyContinueAsNewWorkflowEvents_BaseIsCurrent_BufferedSignal() {
+	// Regression test: base == current, a decision is in flight and a signal arrived
+	// during it, so the signal sat in the current run's buffered events (no event ID,
+	// not counted in NextEventID). Terminating the current run for the reset fails the
+	// decision and flushes that signal into the base run with ID >= currentNextEventID.
+	// It is not in the persisted range [baseRebuildNextEventID, baseNextEventID), so it
+	// must be reapplied from the flushed events, or the acknowledged signal is lost.
+	ctx := context.Background()
+	domainName := "test-domain"
+	baseRebuildNextEventID := int64(20)
+	currentNextEventID := int64(25)
+	currentBranchToken := []byte("some random current branch token")
+
+	persistedSignal := &types.HistoryEvent{
+		ID:        22,
+		EventType: types.EventTypeWorkflowExecutionSignaled.Ptr(),
+		WorkflowExecutionSignaledEventAttributes: &types.WorkflowExecutionSignaledEventAttributes{
+			SignalName: "persisted signal",
+			Input:      []byte("persisted input"),
+			Identity:   "client",
+			RequestID:  "persisted-request-id",
+		},
+	}
+	persistedEvents := []*types.HistoryEvent{
+		{ID: 20, EventType: types.EventTypeDecisionTaskCompleted.Ptr(), DecisionTaskCompletedEventAttributes: &types.DecisionTaskCompletedEventAttributes{}},
+		{ID: 21, EventType: types.EventTypeActivityTaskScheduled.Ptr(), ActivityTaskScheduledEventAttributes: &types.ActivityTaskScheduledEventAttributes{}},
+		persistedSignal,
+		{ID: 23, EventType: types.EventTypeDecisionTaskScheduled.Ptr(), DecisionTaskScheduledEventAttributes: &types.DecisionTaskScheduledEventAttributes{}},
+		{ID: 24, EventType: types.EventTypeDecisionTaskStarted.Ptr(), DecisionTaskStartedEventAttributes: &types.DecisionTaskStartedEventAttributes{}},
+	}
+	s.mockHistoryV2Mgr.On("ReadHistoryBranchByBatch", mock.Anything, &persistence.ReadHistoryBranchRequest{
+		BranchToken:   currentBranchToken,
+		MinEventID:    baseRebuildNextEventID,
+		MaxEventID:    currentNextEventID,
+		PageSize:      execution.NDCDefaultPageSize,
+		NextPageToken: nil,
+		ShardID:       common.IntPtr(s.mockShard.GetShardID()),
+		DomainName:    domainName,
+	}).Return(&persistence.ReadHistoryBranchByBatchResponse{
+		History:       []*types.History{{Events: persistedEvents}},
+		NextPageToken: nil,
+	}, nil).Once()
+	s.mockShard.Resource.DomainCache.EXPECT().GetDomainName(gomock.Any()).Return(domainName, nil).AnyTimes()
+
+	// Pending batch of the current run after terminateWorkflow: the forced
+	// DecisionTaskFailed, the flushed buffered signal, and the termination event.
+	bufferedSignal := &types.HistoryEvent{
+		ID:        26,
+		EventType: types.EventTypeWorkflowExecutionSignaled.Ptr(),
+		WorkflowExecutionSignaledEventAttributes: &types.WorkflowExecutionSignaledEventAttributes{
+			SignalName: "buffered signal",
+			Input:      []byte("buffered input"),
+			Identity:   "client",
+			RequestID:  "buffered-request-id",
+		},
+	}
+	pendingBatch := []*types.HistoryEvent{
+		{ID: 25, EventType: types.EventTypeDecisionTaskFailed.Ptr(), DecisionTaskFailedEventAttributes: &types.DecisionTaskFailedEventAttributes{}},
+		bufferedSignal,
+		{ID: 27, EventType: types.EventTypeWorkflowExecutionTerminated.Ptr(), WorkflowExecutionTerminatedEventAttributes: &types.WorkflowExecutionTerminatedEventAttributes{}},
+	}
+	currentMutableState := execution.NewMockMutableState(s.controller)
+	currentMutableState.EXPECT().GetHistoryBuilder().Return(
+		execution.NewHistoryBuilderFromEvents(pendingBatch, currentMutableState),
+	).Times(1)
+	flushedEvents := getFlushedEvents(currentMutableState, currentNextEventID)
+	s.Equal(pendingBatch, flushedEvents)
+
+	resetMutableState := execution.NewMockMutableState(s.controller)
+	resetMutableState.EXPECT().GetExecutionInfo().Return(&persistence.WorkflowExecutionInfo{}).AnyTimes()
+	gomock.InOrder(
+		resetMutableState.EXPECT().AddWorkflowExecutionSignaled(
+			"persisted signal", []byte("persisted input"), "client", "",
+		).Return(&types.HistoryEvent{}, nil).Times(1),
+		resetMutableState.EXPECT().AddSignalRequested("persisted-request-id").Times(1),
+		resetMutableState.EXPECT().AddWorkflowExecutionSignaled(
+			"buffered signal", []byte("buffered input"), "client", "",
+		).Return(&types.HistoryEvent{}, nil).Times(1),
+		resetMutableState.EXPECT().AddSignalRequested("buffered-request-id").Times(1),
+	)
+
+	// base == current: the current run lock is held by the caller, so nothing must
+	// be loaded through the execution cache.
+	err := s.workflowResetter.reapplyResetAndContinueAsNewWorkflowEvents(
+		ctx,
+		resetMutableState,
+		s.domainID,
+		s.workflowID,
+		s.currentRunID,
+		currentBranchToken,
+		baseRebuildNextEventID,
+		currentNextEventID,
+		s.currentRunID,
+		currentNextEventID,
+		currentBranchToken,
+		flushedEvents,
+	)
+	s.NoError(err)
+}
+
+func (s *workflowResetterSuite) TestReapplyContinueAsNewWorkflowEvents_CurrentNotReached_FlushedEventsIgnored() {
+	// If the reset chain does not reach the current run (base is an unrelated run),
+	// signals flushed into the current run are not reapplied, matching the handling
+	// of the current run's persisted events.
+	ctx := context.Background()
+	domainName := "test-domain"
+	baseFirstEventID := int64(4)
+	baseNextEventID := int64(6)
+	baseBranchToken := []byte("some random base branch token")
+
+	s.mockHistoryV2Mgr.On("ReadHistoryBranchByBatch", mock.Anything, &persistence.ReadHistoryBranchRequest{
+		BranchToken:   baseBranchToken,
+		MinEventID:    baseFirstEventID,
+		MaxEventID:    baseNextEventID,
+		PageSize:      execution.NDCDefaultPageSize,
+		NextPageToken: nil,
+		ShardID:       common.IntPtr(s.mockShard.GetShardID()),
+		DomainName:    domainName,
+	}).Return(&persistence.ReadHistoryBranchByBatchResponse{
+		History: []*types.History{{Events: []*types.HistoryEvent{
+			{ID: 4, EventType: types.EventTypeDecisionTaskCompleted.Ptr(), DecisionTaskCompletedEventAttributes: &types.DecisionTaskCompletedEventAttributes{}},
+			{ID: 5, EventType: types.EventTypeWorkflowExecutionTerminated.Ptr(), WorkflowExecutionTerminatedEventAttributes: &types.WorkflowExecutionTerminatedEventAttributes{}},
+		}}},
+		NextPageToken: nil,
+	}, nil).Once()
+	s.mockShard.Resource.DomainCache.EXPECT().GetDomainName(gomock.Any()).Return(domainName, nil).AnyTimes()
+
+	resetMutableState := execution.NewMockMutableState(s.controller)
+	resetMutableState.EXPECT().GetExecutionInfo().Return(&persistence.WorkflowExecutionInfo{}).AnyTimes()
+
+	err := s.workflowResetter.reapplyResetAndContinueAsNewWorkflowEvents(
+		ctx,
+		resetMutableState,
+		s.domainID,
+		s.workflowID,
+		s.baseRunID,
+		baseBranchToken,
+		baseFirstEventID,
+		baseNextEventID,
+		s.currentRunID,
+		int64(10),
+		[]byte("some random current branch token"),
+		[]*types.HistoryEvent{{
+			ID:        11,
+			EventType: types.EventTypeWorkflowExecutionSignaled.Ptr(),
+			WorkflowExecutionSignaledEventAttributes: &types.WorkflowExecutionSignaledEventAttributes{
+				SignalName: "buffered signal",
+			},
+		}},
 	)
 	s.NoError(err)
 }
