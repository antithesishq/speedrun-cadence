From a7da2f80c29e5eb0940066b9a6410d7051a9f875 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Wed, 18 Nov 2026 20:43:33 +0000
Subject: [PATCH] fix(reset): reapply buffered signals flushed by terminating
 the current run

When base == current and a decision is in flight, signals received during the
decision are buffered. Terminating the current run for the reset fails the
decision and flushes them into the terminated run with IDs >= the captured
next event ID, outside the persisted range that is reapplied. Collect those
flushed events and reapply them when the reset chain reaches the current run.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 service/history/reset/resetter.go      |  42 +++++++
 service/history/reset/resetter_test.go | 155 +++++++++++++++++++++++++
 2 files changed, 197 insertions(+)

diff --git a/service/history/reset/resetter.go b/service/history/reset/resetter.go
index 55260399e..9564f9a04 100644
--- a/service/history/reset/resetter.go
+++ b/service/history/reset/resetter.go
@@ -135,6 +135,7 @@ func (r *workflowResetterImpl) ResetWorkflow(
 	}
 
 	currentWorkflowTerminated := false
+	var currentFlushedEvents []*types.HistoryEvent
 	if currentMutableState.IsWorkflowExecutionRunning() {
 		if err := r.terminateWorkflow(
 			currentMutableState,
@@ -144,6 +145,11 @@ func (r *workflowResetterImpl) ResetWorkflow(
 		}
 		resetWorkflowVersion = currentMutableState.GetCurrentVersion()
 		currentWorkflowTerminated = true
+		// Terminating the current run fails its in-flight decision, which flushes
+		// buffered events (e.g. signals received while the decision was running)
+		// into the current run with IDs >= currentNextEventID. Those events are not
+		// in persisted history yet, so collect them here for reapplication.
+		currentFlushedEvents = getFlushedEvents(currentMutableState, currentNextEventID)
 	}
 
 	resetWorkflow, err := r.prepareResetWorkflow(
@@ -164,6 +170,7 @@ func (r *workflowResetterImpl) ResetWorkflow(
 		currentRunID,
 		currentNextEventID,
 		currentBranchToken,
+		currentFlushedEvents,
 	)
 	if err != nil {
 		return err
@@ -196,6 +203,7 @@ func (r *workflowResetterImpl) prepareResetWorkflow(
 	currentRunID string,
 	currentNextEventID int64,
 	currentBranchToken []byte,
+	currentFlushedEvents []*types.HistoryEvent,
 ) (execution.Workflow, error) {
 
 	resetWorkflow, err := r.replayResetWorkflow(
@@ -260,6 +268,7 @@ func (r *workflowResetterImpl) prepareResetWorkflow(
 			currentRunID,
 			currentNextEventID,
 			currentBranchToken,
+			currentFlushedEvents,
 		); err != nil {
 			return nil, err
 		}
@@ -496,6 +505,7 @@ func (r *workflowResetterImpl) reapplyResetAndContinueAsNewWorkflowEvents(
 	currentRunID string,
 	currentNextEventID int64,
 	currentBranchToken []byte,
+	currentFlushedEvents []*types.HistoryEvent,
 ) error {
 
 	// TODO change this logic to fetching all workflow [baseWorkflow, currentWorkflow]
@@ -514,6 +524,7 @@ func (r *workflowResetterImpl) reapplyResetAndContinueAsNewWorkflowEvents(
 	); err != nil {
 		return err
 	}
+	reachedCurrentRun := baseRunID == currentRunID
 
 	getNextEventIDBranchToken := func(runID string) (nextEventID int64, branchToken []byte, retError error) {
 		// The caller (processResetWorkflow) already holds the execution context lock for
@@ -553,6 +564,9 @@ func (r *workflowResetterImpl) reapplyResetAndContinueAsNewWorkflowEvents(
 
 	// second for remaining continue as new workflow, reapply eligible events
 	for len(nextRunID) != 0 {
+		if nextRunID == currentRunID {
+			reachedCurrentRun = true
+		}
 		nextWorkflowNextEventID, nextWorkflowBranchToken, err := getNextEventIDBranchToken(nextRunID)
 		if err != nil {
 			return err
@@ -568,9 +582,37 @@ func (r *workflowResetterImpl) reapplyResetAndContinueAsNewWorkflowEvents(
 			return err
 		}
 	}
+
+	// finally, the events flushed into the current run by its termination (buffered
+	// signals); they come after all of its persisted events read above.
+	if reachedCurrentRun {
+		if err := r.reapplyEvents(resetMutableState, currentFlushedEvents); err != nil {
+			return err
+		}
+	}
 	return nil
 }
 
+// getFlushedEvents returns the events in the mutable state's pending (not yet
+// persisted) history batch whose ID is >= nextEventID, i.e. those added after
+// nextEventID was captured, including buffered events flushed by FailDecision.
+func getFlushedEvents(
+	mutableState execution.MutableState,
+	nextEventID int64,
+) []*types.HistoryEvent {
+	historyBuilder := mutableState.GetHistoryBuilder()
+	if historyBuilder == nil {
+		return nil
+	}
+	var events []*types.HistoryEvent
+	for _, event := range historyBuilder.GetHistory().Events {
+		if event.ID >= nextEventID {
+			events = append(events, event)
+		}
+	}
+	return events
+}
+
 func (r *workflowResetterImpl) reapplyWorkflowEvents(
 	ctx context.Context,
 	mutableState execution.MutableState,
